# Production/Supabase PostgreSQL connection. Never commit the real value.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@HOST:5432/postgres

# Bootstrap admin (set these in your deployment provider's environment).
SYTECH_ADMIN_NAME=System Administrator
SYTECH_ADMIN_CONTACT=+26770000000
SYTECH_ADMIN_PASSWORD=replace-with-a-long-random-password

# Keep disabled in production. Enables simulated checkout/OSINT demo flows.
SYTECH_DEMO_MODE=0
