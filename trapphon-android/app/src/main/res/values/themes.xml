<resources>
    <style name="Theme.TrapPhon" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:navigationBarColor">@color/primary_dark</item>
    </style>

    <style name="Theme.TrapPhon.FullscreenHoneypot" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/lockdown_bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/lockdown_bg</item>
        <item name="android:navigationBarColor">@color/lockdown_bg</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>
</resources>
