<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Secret 5-Tap Gesture Target: Company Logo -->
    <ImageView
        android:id="@+id/ivHoneypotLogo"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="24dp"
        android:background="#0C4A6E"
        android:contentDescription="SYTECH Shield Logo (5 Taps for Master Exit)"
        android:padding="16dp"
        android:src="@android:drawable/ic_lock_lock" />

    <TextView
        android:id="@+id/tvLockdownTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/honeypot_title"
        android:textColor="#EF4444"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvLockdownWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:text="@string/honeypot_warning"
        android:textColor="#E2E8F0"
        android:textSize="14sp"
        android:lineSpacingMultiplier="1.2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E293B"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="System State: Factory Setup Mode"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Cellular Status: Awaiting SIM Insertion"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/emergency_call_only"
        android:textColor="#64748B"
        android:textSize="13sp" />

</LinearLayout>
